          <mxGeometry x="460" y="280" width="280" height="50" as="geometry"/>
        </mxCell>
        <!-- 步骤4：可靠性检验 -->
        <mxCell id="q2_s4" value="可靠性检验&#xa;残差诊断 / 交叉验证 / 噪声测试" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="460" y="345" width="280" height="50" as="geometry"/>
        </mxCell>
        <!-- 问题二输出 -->
