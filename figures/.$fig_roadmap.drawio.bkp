          <mxGeometry x="430" y="110" width="340" height="30" as="geometry"/>
        </mxCell>

        <!-- 问题三标题 -->
        <mxCell id="q3_title" value="问题三：多光束干涉与材料判定" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#c55a11;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="110" width="340" height="30" as="geometry"/>
        </mxCell>

        <!-- ============ 问题一步骤 ============ -->
        <!-- 步骤1：物理建模 -->
        <mxCell id="q1_s1" value="三层介质结构&#xa;双光束干涉相位差" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2e75b6;strokeColor=none;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;arcSize=15;" vertex="1" parent="1">
