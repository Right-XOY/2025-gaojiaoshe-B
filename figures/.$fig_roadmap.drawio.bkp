        <mxCell id="q3_s1" value="多光束干涉模型（Airy公式）&#xa;逐次反射复振幅等比级数求和" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;arcSize=15;" vertex="1" parent="1">
