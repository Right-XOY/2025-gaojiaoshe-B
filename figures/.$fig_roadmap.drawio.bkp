        <mxCell id="q2_a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#70ad47;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" parent="1" source="q2_s2" target="q2_s3">
